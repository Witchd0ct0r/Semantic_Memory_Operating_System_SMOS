# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored. Never commit it.

# First start only: creates the initial admin. Once the admin exists these two are ignored.
SMOS_ADMIN_USER=admin
SMOS_ADMIN_PASSWORD=change-me

# The address users really type, used in the invitation links the admin sends out.
SMOS_PUBLIC_URL=http://your-host:8765

# Optional
# SMOS_HOST_PORT=8765          # port on this server; change it if 8765 is blocked or in use
# SMOS_INVITE_TTL_HOURS=72
# SMOS_USAGE_RETENTION_DAYS=90
# SMOS_TRUST_PROXY=1
# TORCH_INDEX_URL=
# SMOS_UPDATE_REPO=owner/name   # where the dashboard looks for new releases; empty turns updating off
# SMOS_UPDATE_CHECK_MINUTES=360 # how often it checks (5 to 10080)
# HTTPS_PROXY=http://proxy:3128 # only if the server reaches GitHub through a proxy (NO_PROXY works too)
# SMOS_TORCH_THREADS=1          # threads torch uses per embedding; try 1 or 2 on a small server, unset keeps the default
