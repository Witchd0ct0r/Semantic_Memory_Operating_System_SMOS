# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Runtime data — never commit
.smos/
data/
workspace/
logs/
*.db
*.db-shm
*.db-wal
*.index

# Sandbox — isolated scratch projects (e.g. toolchain benchmark). Corpus text,
# generated .smos/ stores, and raw payload dumps are bulky/regenerable and
# stay untracked; scripts, question sets, and write-ups are tracked.
sandbox/*/corpus/
sandbox/*/.smos/
sandbox/*/payloads/
sandbox/*/*.json
sandbox/*/*.txt

# Tests
.pytest_cache/
.coverage
htmlcov/

# Editors
.vscode/
.idea/
*.swp
*.swo

# Claude Code local settings
.claude/settings.local.json

# Git worktrees (isolated dev workspaces)
.worktrees/

# OS
.DS_Store
Thumbs.db

.superpowers/
.env
